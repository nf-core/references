/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'BUILD_INTERVALS' {
        ext.args   = { "-v FS='\t' -v OFS='\t' '{ print \$1, \"0\", \$2 }'" }
        ext.suffix = { "bed" }
    }
    withName: 'GFFREAD' {
        ext.args   = '--keep-exon-attrs -F -T'
    }
    withName: 'KALLISTO_INDEX' {
        ext.args   = { params.kallisto_make_unique ? '--make-unique' : '' }
    }
    withName: 'NCBIDATASETSCLI_DATASETS' {
        ext.args   = { System.getenv('NCBI_API_KEY') ? "--api-key ${System.getenv('NCBI_API_KEY')}" : '' }
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }
    withName: 'RSEM_PREPAREREFERENCE_GENOME' {
        ext.args   = '--star'
    }
    withName: 'STAR_GENOMEGENERATE' {
        ext.args   = {
            def args = []
            // CLI params have highest priority
            if (params.star_sjdbOverhang) {
                args << "--sjdbOverhang ${params.star_sjdbOverhang}"
            } else if (meta.params?.star?.sjdbOverhang) {
                args << "--sjdbOverhang ${meta.params.star.sjdbOverhang}"
            }
            if (params.star_genomeSAindexNbases) {
                args << "--genomeSAindexNbases ${params.star_genomeSAindexNbases}"
            } else if (meta.params?.star?.genomeSAindexNbases) {
                args << "--genomeSAindexNbases ${meta.params.star.genomeSAindexNbases}"
            }
            args.join(' ')
        }
    }
}
