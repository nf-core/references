nextflow_pipeline {

    name "Build bwa-mem3 references"
    script "../main.nf"
    tag "pipeline"

    test("-profile test --tools bwamem3,bwamem3meth") {

        options "-output-dir ${outputDir}"

        when {
            params {
                outdir       = "${outputDir}"
                tools        = 'bwamem3,bwamem3meth'
                tools_bundle = null
                skip_tools   = null
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                // The --meth index keeps only its own seed index, not the plain .bwt.2bit.64
                { assert stable_path.any { file -> file.contains('/BWAmem3Index/0.17.0/') && file.endsWith('.bwt.2bit.64') && !file.endsWith('.meth.bwt.2bit.64') } },
                { assert stable_path.any { file -> file.contains('/BWAmem3MethIndex/0.17.0/') && file.endsWith('.meth.bwt.2bit.64') } },
                { assert stable_path.findAll { file -> file.contains('/BWAmem3MethIndex/0.17.0/') && file.endsWith('.bwt.2bit.64') }.every { file -> file.endsWith('.meth.bwt.2bit.64') } },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow and pipeline versions are removed (all from the workflow key)
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_references_software_mqc_versions.yml", 'Workflow'),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }

    test("-profile test --tools_bundle methylseq") {

        options "-output-dir ${outputDir}"

        when {
            params {
                outdir       = "${outputDir}"
                tools        = null
                tools_bundle = 'methylseq'
                skip_tools   = null
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_references_software_mqc_versions.yml", 'Workflow'),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}
